# Core Environment Settings
PROJECT_NAME="EnterpriseOps AI - Compliance Investigation Platform"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API Server Settings
HOST="0.0.0.0"
PORT=8000

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="enterprise_ai_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/enterprise_ai_db"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# OpenTelemetry Settings
OTEL_SERVICE_NAME="enterprise-ai-ops"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
